# Copy this file to .env for local development. Never commit .env.
NODE_ENV=development
PORT=8787
APP_URL=http://localhost:5173
STATIC_DIR=dist

# Local PostgreSQL (docker compose up -d db)
DATABASE_URL=postgres://lolo:lolo@127.0.0.1:5432/lolo
AUTO_MIGRATE=true

# Auth / email. Without RESEND_API_KEY, magic links are logged by the server.
SESSION_COOKIE=lolo_session
SESSION_TTL_HOURS=720
MAGIC_LINK_TTL_MINUTES=15
# RESEND_API_KEY=
# MAIL_FROM=Lolo <onboarding@resend.dev>

# Local model provider (optional; only works if Ollama is running)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_MS=120000
OLLAMA_KEEPALIVE_MS=45000

# Hosted AI provider. Add the secret only to the backend host in production.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional alternative provider
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

COOLDOWN_MS=30000
MAX_ATTEMPTS=3
API_RATE_LIMIT=600
API_RATE_WINDOW_MS=60000
RATE_LIMIT_MAX_KEYS=20000
LOG_LEVEL=info

# Frontend build variables. For a hosted backend, replace the URL with its public API URL.
VITE_API_MODE=http
VITE_API_URL=http://localhost:8787
